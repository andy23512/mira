{
	"name": "mira",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Mira — an unofficial learning-curve percentile explorer for CharaChorder devices",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"preview": "vite preview",
